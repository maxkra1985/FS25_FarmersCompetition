<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<sound xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/ambientSounds.xsd">
    <ambient3d filename="maps/sounds.i3d" />


    <ambient>
	</ambient>
        <!-- Info:
        Sample
            filename:                   path to file

        Settings:
            audioGroup:                 the audio group the sound will be assigned to
            minVolume:                  the minVolume if the player is outdoor (default 1)
            maxVolume:                  the maxVolume if the player is outdoor (default 1)
            indoorVolume:               the volume if the player is indoor or in a vehicle
            minLoops:                   the minimum number of loops played once a sound is triggered
            maxLoops:                   the maximum number of loops played once a sound is triggered
            minRetriggerDelaySeconds:   the minimum number of seconds until sound can be retriggred
            maxRetriggerDelaySeconds:   the maximum number of seconds until the sound has to be retriggered
            minPitch:                   the minPitch (default 1)
            maxPitch:                   the maxPitch (default 1)
            minDelay:                   the minDelay (default 0)
            maxDelay:                   the maxDelay (default 0)
            fadeInTime:                 the fadeIn time (default 0)
            fadeOutTime:                the fadeOut time (default 0)
            minLength:                  the minLength time (default 0)
            maxLength:                  the maxLength time (default 0)

            <required /> :   ALL attributes have to be active
            <prevent />  :   If ONE of these attributes is active the sound won't be active

            Available attributes:

                spring
                summer
                autumn
                winter
                sun
                rain
                cloudy
                snow
                inForest
                nearWater
                inVehicle
                outVehicle
                isIndoor
        -->
    <!--Environment-->


    <surface>
        <!--
            materialId      layer name
            1               dirt
            2               grass
            3               beachSand
            4
            5               leaves
            6               gravel
            7               rock, asphalt, plate (also used for 'on object')
            99              shallowWater

            Note:
        -->

        <material materialId="0"  name="field"         type="wheel" loopCount="0" template="defaultSurfaceField" />
        <material materialId="1"  name="dirt"          type="wheel" loopCount="0" template="defaultSurfaceDirt" />
        <material materialId="2"  name="grass"         type="wheel" loopCount="0" template="defaultSurfaceGrass" />
        <material materialId="3"  name="sand"          type="wheel" loopCount="0" template="defaultSurfaceSand" />
        <material materialId="4"  name="sound"         type="wheel" loopCount="0" template="defaultSurfaceSound" />
        <material materialId="5"  name="leaves"        type="wheel" loopCount="0" template="defaultSurfaceGrass" />
        <material materialId="6"  name="gravel"        type="wheel" loopCount="0" template="defaultSurfaceGravel" />
        <material materialId="7"  name="asphalt"       type="wheel" loopCount="0" template="defaultSurfaceAsphalt" />
        <material materialId="0"  name="snow"          type="wheel" loopCount="0" template="defaultSurfaceSnow" />
        <material materialId="97" name="railroad"      type="wheel" loopCount="0" template="defaultSurfaceRailroad" />
        <material materialId="98" name="mediumWater"   type="wheel" loopCount="0" template="defaultSurfaceWaterMedium" />
        <material materialId="99" name="shallowWater"  type="wheel" loopCount="0" template="defaultSurfaceWaterShallow" />

        <material materialId="0"  name="field"         type="footstep" loopCount="1" template="defaultFootstepField" />
        <material materialId="1"  name="dirt"          type="footstep" loopCount="1" template="defaultFootstepDirt" />
        <material materialId="2"  name="grass"         type="footstep" loopCount="1" template="defaultFootstepGrass" />
        <material materialId="3"  name="sand"          type="footstep" loopCount="1" template="defaultFootstepSand" />
        <material materialId="4"  name="sound"         type="footstep" loopCount="1" template="defaultFootstepSound" />
        <material materialId="5"  name="leaves"        type="footstep" loopCount="1" template="defaultFootstepGrass" />
        <material materialId="6"  name="gravel"        type="footstep" loopCount="1" template="defaultFootstepGravel" />
        <material materialId="7"  name="asphalt"       type="footstep" loopCount="1" template="defaultFootstepAsphalt" />
        <material materialId="8"  name="wetMud"        type="footstep" loopCount="1" template="defaultFootstepWaterShallow" />
        <material materialId="97" name="snow"          type="footstep" loopCount="1" template="defaultFootstepSnow" />
        <material materialId="98" name="mediumWater"   type="footstep" loopCount="1" template="defaultFootstepWaterMedium" />
        <material materialId="99" name="shallowWater"  type="footstep" loopCount="1" template="defaultFootstepWaterShallow" />

        <material materialId="0"  name="field"         type="hoofstep" loopCount="1" template="defaultHoofstepField" />
        <material materialId="1"  name="dirt"          type="hoofstep" loopCount="1" template="defaultHoofstepDirt" />
        <material materialId="2"  name="grass"         type="hoofstep" loopCount="1" template="defaultHoofstepGrass" />
        <material materialId="3"  name="sand"          type="hoofstep" loopCount="1" template="defaultHoofstepSand" />
        <material materialId="4"  name="sound"         type="hoofstep" loopCount="1" template="defaultHoofstepSound" />
        <material materialId="5"  name="leaves"        type="hoofstep" loopCount="1" template="defaultHoofstepGrass" />
        <material materialId="6"  name="gravel"        type="hoofstep" loopCount="1" template="defaultHoofstepGravel" />
        <material materialId="7"  name="asphalt"       type="hoofstep" loopCount="1" template="defaultHoofstepAsphalt" />
        <material materialId="97" name="snow"          type="hoofstep" loopCount="1" template="defaultHoofstepSnow" />
        <material materialId="98" name="mediumWater"   type="hoofstep" loopCount="1" template="defaultHoofstepWaterMedium" />
        <material materialId="99" name="shallowWater"  type="hoofstep" loopCount="1" template="defaultHoofstepWaterShallow" />
    </surface>

    <cutting>
        <sample name="tree" file="$data/sounds/tools/forestry/tree_fall_01.wav" >
            <sourceRandomization file="$data/sounds/tools/forestry/tree_fall_02.wav" />
            <sourceRandomization file="$data/sounds/tools/forestry/tree_fall_03.wav" />
            <sourceRandomization file="$data/sounds/tools/forestry/tree_fall_04.wav" />
            <sourceRandomization file="$data/sounds/tools/forestry/tree_fall_05.wav" />
        </sample>
    </cutting>
</sound>
